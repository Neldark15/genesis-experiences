{
  "rewrites": [
    { "source": "/reservas", "destination": "/" },
    { "source": "/disponibilidad", "destination": "/" },
    { "source": "/ubicacion", "destination": "/" },
    { "source": "/resenas", "destination": "/" },
    { "source": "/en/reservas", "destination": "/en/" },
    { "source": "/en/disponibilidad", "destination": "/en/" },
    { "source": "/en/ubicacion", "destination": "/en/" },
    { "source": "/en/resenas", "destination": "/en/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
